{
  "name": "folio-book-formatter",
  "version": "1.0.2",
  "private": true,
  "description": "Folio — a desktop book formatter for Windows with live preview and publish-ready EPUB/PDF export.",
  "author": "Folio contributors; based on Byte-Sized Book Formatter by Angie Hartwell",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "pretest": "npm run build:web",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cross-env BOOK_FORMATTER_DEV=1 tsx watch server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/server.mjs",
    "build": "npm run build:web && npm run build:server",
    "start": "npm run build && tsx server/index.ts",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "blues": "tsx server/cli-blues.ts",
    "test": "node --import tsx tests/run-all.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "hyphenation.en-us": "^0.2.1",
    "hyphenation.pl": "^0.2.1",
    "hypher": "^0.2.5",
    "js-yaml": "^4.1.0",
    "multer": "2.3.0",
    "open": "^10.1.0",
    "pagedjs": "^0.4.3",
    "puppeteer": "25.10.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "2.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.folio.bookformatter",
    "productName": "Folio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist-server/**/*",
      "web/dist/**/*",
      "scripts/packaged-ui-smoke.mjs",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "themes",
        "to": "app-resources/themes"
      },
      {
        "from": "templates",
        "to": "app-resources/templates"
      },
      {
        "from": "samples",
        "to": "app-resources/samples"
      },
      {
        "from": "server/filters",
        "to": "app-resources/server/filters"
      },
      {
        "from": "server/templates",
        "to": "app-resources/server/templates"
      },
      {
        "from": "node_modules/pagedjs/dist/paged.polyfill.min.js",
        "to": "app-resources/vendor/paged.polyfill.min.js"
      },
      {
        "from": "build/pandoc",
        "to": "pandoc"
      },
      {
        "from": "build/puppeteer-cache",
        "to": "chromium"
      }
    ],
    "win": {
      "executableName": "Folio",
      "icon": "assets/folio.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Folio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Folio-${version}-setup.exe",
      "shortcutName": "Folio",
      "uninstallDisplayName": "Folio"
    },
    "portable": {
      "artifactName": "Folio-${version}-portable.exe"
    }
  }
}
