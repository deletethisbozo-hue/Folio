node_modules/
web/dist/
dist-server/
release/
build/
output/

# Optional third-party validation tools. Folio always performs its built-in
# structural EPUB validation when these development-only tools are absent.
vendor/
*.log
.DS_Store
.tmp/

# Scratch. NB: this also hides anything named _foo.ts at the repo root, which is
# how the whole regression suite once ended up untracked — if it matters, it goes
# in tests/, not here.
_*

# Pinned built-in fonts are fetched from Google Fonts at build time.
themes/fonts/
